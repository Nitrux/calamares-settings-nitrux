#!/usr/bin/env bash

# SPDX-License-Identifier: BSD-3-Clause
# Copyright 2026 <Nitrux Latinoamericana S.C. <hello@nxos.org>>

set -euo pipefail

if [ ! -d /sys/firmware/efi ] || [ ! -d /boot/efi ]; then
    exit 0
fi

EFI_DIR=/boot/efi/EFI/Nitrux
mkdir -p "$EFI_DIR"

copy_signed_image() {
    local source_path="$1"
    local target_path="$2"

    if [ ! -r "$source_path" ]; then
        echo "Error: required Secure Boot image is missing: $source_path" >&2
        exit 1
    fi

    install -m 0644 "$source_path" "$target_path"
}

SHIM_IMAGE=/usr/lib/shim/shimx64.efi.signed
MOK_MANAGER_IMAGE=/usr/lib/shim/mmx64.efi.signed
FALLBACK_IMAGE=/usr/lib/shim/fbx64.efi.signed
GRUB_IMAGE=/usr/lib/grub/x86_64-efi-signed/grubx64.efi.signed

copy_signed_image "$SHIM_IMAGE" "$EFI_DIR/shimx64.efi"
copy_signed_image "$MOK_MANAGER_IMAGE" "$EFI_DIR/mmx64.efi"
copy_signed_image "$FALLBACK_IMAGE" "$EFI_DIR/fbx64.efi"
copy_signed_image "$GRUB_IMAGE" "$EFI_DIR/grubx64.efi"

EFI_BOOT_DIR=/boot/efi/EFI/BOOT
if [ ! -e "$EFI_BOOT_DIR/BOOTX64.EFI" ] &&
    [ ! -e "$EFI_BOOT_DIR/grubx64.efi" ] &&
    [ ! -e "$EFI_BOOT_DIR/mmx64.efi" ]; then
    mkdir -p "$EFI_BOOT_DIR"
    copy_signed_image "$SHIM_IMAGE" "$EFI_BOOT_DIR/BOOTX64.EFI"
    copy_signed_image "$GRUB_IMAGE" "$EFI_BOOT_DIR/grubx64.efi"
    copy_signed_image "$MOK_MANAGER_IMAGE" "$EFI_BOOT_DIR/mmx64.efi"
else
    echo "Preserving the existing EFI fallback loader in $EFI_BOOT_DIR." >&2
fi

if [ ! -r /usr/share/grub/nitrux-secure-boot.cer ]; then
    echo "Error: Nitrux Secure Boot certificate is missing: /usr/share/grub/nitrux-secure-boot.cer" >&2
    exit 1
fi
install -m 0644 /usr/share/grub/nitrux-secure-boot.cer "$EFI_DIR/nitrux-secure-boot.cer"

if [ ! -r /usr/share/nitrux/secure-boot/kernel.cer ]; then
    echo "Error: kernel Secure Boot certificate is missing: /usr/share/nitrux/secure-boot/kernel.cer" >&2
    exit 1
fi
install -m 0644 /usr/share/nitrux/secure-boot/kernel.cer "$EFI_DIR/nitrux-kernel-secure-boot.cer"
